{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "packages/**/*"],
  "exclude": ["**/__tests__/*", "packages/*/node_modules"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "ribo-contracts/geometry": ["./packages/ribo-contracts/src/geometry.ts"],
      "ribo-contracts": ["./packages/ribo-contracts/src/index.ts"],
      "ribo-geometry": ["./packages/ribo-geometry/src/index.ts"],
      "ribo-model": ["./packages/ribo-model/src/index.ts"]
    }
  }
}
